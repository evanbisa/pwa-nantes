# Variables des fonctions serveur (Supabase Edge Functions).
#
# EN LIGNE : rien à écrire dans un fichier. Les secrets se saisissent dans Supabase › Edge Functions › Secrets
# (jamais dans le dépôt, un e-mail ou une conversation). SUPABASE_URL et les clés du projet sont fournies par Supabase.
#
# EN LOCAL : copier ce fichier en « .env » (ignoré par git, jamais publié), le remplir, puis
#   supabase functions serve --env-file supabase/functions/.env

# --- Paiement (whop-billing, whop-webhook, delete-account) ---
# Clé d'API de l'entreprise Whop (Whop › Developer › API keys)
WHOP_API_KEY=
# Secret des notifications Whop, « ws_… » (Whop › Developer › Webhooks)
WHOP_WEBHOOK_SECRET=
# Adresse de l'API Whop : à laisser vide (valeur par défaut) sauf copie locale de test
WHOP_API_URL=

# --- Anti-robots (client-signup) : clé SECRÈTE Cloudflare Turnstile ; vide = contrôle désactivé ---
TURNSTILE_SECRET_KEY=

# --- Réglages de test : à NE PAS définir en ligne ---
# SIRET fictif 999 999 999 00009 accepté (verify-siret) : true en local uniquement
ALLOW_TEST_SIRET=
# Sites locaux (http://localhost:…) autorisés à appeler les fonctions depuis un navigateur : 1 en local uniquement
CORS_ALLOW_LOCALHOST=
# Services remplacés par des copies locales dans les tests
SIRENE_API_URL=
MAIL_DNS_URL=
PUSH_ENDPOINT_ALLOW=
TURNSTILE_VERIFY_URL=
