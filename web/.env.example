# Copier en .env.local (développement) et renseigner les mêmes variables dans Vercel.

# Supabase — Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur (jamais exposée au navigateur) : vérification SIRET, webhook Stripe
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers › API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Fonds de carte (facultatif) — par défaut CARTO Voyager / Dark Matter
# NEXT_PUBLIC_MAP_TILES_DAY=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
# NEXT_PUBLIC_MAP_TILES_NIGHT=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
