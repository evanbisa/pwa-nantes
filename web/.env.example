# Copier en .env.local (développement) et renseigner les mêmes variables dans Netlify (Site configuration › Environment variables).
# Supabase › Project Settings › API Keys

# Publiques (envoyées au navigateur) : protégées par la RLS
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# SECRÈTE (serveur uniquement, jamais préfixée NEXT_PUBLIC_, jamais commitée)
# Sert à enregistrer le SIRET vérifié et à créer la fiche d'un restaurateur.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
