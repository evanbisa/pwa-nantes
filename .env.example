# Réglages du site (index.html) appliqués à la publication par scripts/config.mjs.
# En ligne : Vercel › Settings › Environment Variables, et variable du dépôt GitHub (Actions › Variables).
# En local : copier ce fichier en .env (jamais publié), puis : node scripts/config.mjs && node scripts/csp.mjs

# Style de la carte : flashmiam (par défaut : Urbain énergique le jour, Nuit néon la nuit), google, neon, pastel,
# urbain, ou l'adresse https d'un style MapLibre (style.json).
# Essai sans rien publier : ajouter ?carte=neon (ou pastel, urbain, google, flashmiam) à l'adresse du site.
MAP_STYLE=flashmiam
